rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================
    // USER-SCOPED STORAGE
    // ============================================
    // Allow users to access only their own files under users/{userId}/
    match /users/{userId}/{allPaths=**} {
      // Allow read/write only if the authenticated user matches the path ID
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Additional validations for writes
      allow create, update: if request.resource.size < 10 * 1024 * 1024 // Max 10MB
                           && request.resource.contentType.matches('image/.*');
    }
    
    // ============================================
    // LEGACY STORAGE (For older files if any)
    // ============================================
    match /trades/{tradeId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write, delete: if false; // Deny direct writes to root legacy folder
    }
    
    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
