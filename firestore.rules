rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // USER-SCOPED DATA (Primary Structure)
    // ============================================
    // Each user can only read and write their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ============================================
    // SHARED COLLECTIONS
    // ============================================
    // Custody overrides and general reminders for Dominic calendar (shared)
    match /custody_overrides/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /general_reminders/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /annual_reminders/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // ============================================
    // LEGACY COLLECTIONS (Temporary - For Migration)
    // ============================================
    // Allow READ-ONLY access to old root collections for data migration
    // TODO: Remove these rules after all users have migrated their data
    match /trades/{document=**} {
      allow read: if request.auth != null;
    }
    match /accounts/{document=**} {
      allow read: if request.auth != null;
    }
    match /transactions/{document=**} {
      allow read: if request.auth != null;
    }
    match /categories/{document=**} {
      allow read: if request.auth != null;
    }
    match /budgets/{document=**} {
      allow read: if request.auth != null;
    }
    match /recurringDebts/{document=**} {
      allow read: if request.auth != null;
    }
    
    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
