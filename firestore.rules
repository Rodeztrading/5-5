rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasPaidAccess(userId) {
      let subscriptionPath = /databases/$(database)/documents/users/$(userId)/subscriptions/mercadopago;
      return exists(subscriptionPath)
        && get(subscriptionPath).data.accessUntil is timestamp
        && get(subscriptionPath).data.accessUntil > request.time
        && get(subscriptionPath).data.status in ['active', 'cancelled', 'paused', 'past_due'];
    }

    match /users/{userId}/{collectionName}/{documentId} {
      allow read, write: if isOwner(userId)
        && hasPaidAccess(userId)
        && collectionName in [
          'accounts',
          'budgets',
          'categories',
          'fixedExpenseSkips',
          'recurringDebts',
          'transactions'
        ];
    }

    // Subscription state may be written by trusted server code only.
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
